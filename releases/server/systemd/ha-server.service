[Unit]
Description=HA Voice Assistant Server
After=network-online.target ha-music-gateway.service
Wants=network-online.target
Requires=ha-music-gateway.service

[Service]
Type=simple
User=ha
Group=ha
WorkingDirectory=/opt/ha/current
EnvironmentFile=/etc/ha/server.env
ExecStart=/usr/bin/node apps/server/src/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
