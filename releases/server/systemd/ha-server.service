[Unit]
Description=HA Voice Assistant Server
After=network-online.target ha-containers.service ha-music-gateway.service
Wants=network-online.target
Requires=ha-containers.service ha-music-gateway.service
PropagatesStopTo=ha-music-gateway.service ha-containers.service

[Service]
Type=simple
User=ha
Group=ha
WorkingDirectory=/opt/ha/current
EnvironmentFile=/etc/ha/server.env
TimeoutStartSec=30min
ExecStartPre=/opt/ha/current/apps/server/ensure-whisper-model.sh /var/lib/ha/models/whisper
ExecStart=/usr/bin/node apps/server/src/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
