SATELLITE_ID=raspberry-satellite-1
DISPLAY_PORT=8080
AUDIO_API_PORT=3200
AUDIO_CONFIG_PATH=/etc/ha/satellite/audio.json
ASSISTANT_CONFIG_PATH=/etc/ha/satellite/assistant.json
SERVER_CONFIG_PATH=/etc/ha/satellite/server.json
SERVER_RECONNECT_DELAY_MS=10000

WAKE_WORD_PROVIDER=vosk
WAKE_WORD_MODELS_PATH=/var/lib/ha/models/wake-word
WAKE_WORD_COMMAND_TIMEOUT_MS=7000
WAKE_WORD_COOLDOWN_MS=2000
WAKE_WORD_EXACT_MIN_CONFIDENCE=0.72
WAKE_WORD_EMBEDDED_MIN_CONFIDENCE=0.90
VOICE_SILENCE_DURATION_MS=800
VOICE_DUCK_VOLUME_PERCENT=10
VOICE_MAX_PHRASE_SECONDS=8
VOICE_INITIAL_NOISE_FLOOR_DB=-50
VOICE_SPEECH_START_MARGIN_DB=10
VOICE_SPEECH_END_MARGIN_DB=6
VOICE_COMMAND_SPEECH_START_MARGIN_DB=6
VOICE_COMMAND_MINIMUM_SPEECH_MS=100
VOICE_COMMAND_PRE_ROLL_MS=400

VOSK_PYTHON=/opt/ha/venvs/satellite/bin/python
VOSK_SCRIPT_PATH=/opt/ha/current/apps/satellite/src/voice/vosk_detector.py
VOSK_MODEL_PATH=/var/lib/ha/models/vosk-model-small-es-0.42
OPENWAKEWORD_PYTHON=/opt/ha/venvs/satellite/bin/python
OPENWAKEWORD_SCRIPT_PATH=/opt/ha/current/apps/satellite/src/voice/openwakeword_detector.py
OPENWAKEWORD_THRESHOLD=0.995
OPENWAKEWORD_PATIENCE=2
OPENWAKEWORD_MIN_AUDIO_DB=-55
OPENWAKEWORD_AUDIO_ACTIVITY_WINDOW_MS=1000
WAKE_WORD_MODEL_REFRESH_MS=60000
WAKE_WORD_POST_TTS_GUARD_MS=1500
PIPER_EXECUTABLE=/opt/ha/venvs/satellite/bin/piper
PIPER_PYTHON=/opt/ha/venvs/satellite/bin/python
PIPER_MODELS_PATH=/var/lib/ha/models/piper

SENDSPIN_EXECUTABLE=/opt/ha/tools/bin/sendspin
MUSIC_ASSISTANT_SENDSPIN_URL=
