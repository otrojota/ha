[Unit]
Description=HA Satellite local display
After=network.target

[Service]
Type=simple
User=@@SATELLITE_USER@@
Group=@@SATELLITE_GROUP@@
WorkingDirectory=/opt/ha/current
EnvironmentFile=/etc/ha/satellite.env
ExecStart=/usr/bin/node deploy/display-server.mjs
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
