# Identidad estable que Music Assistant conservará entre reinicios.
SATELLITE_ID=dev-satellite-1
SENDSPIN_EXECUTABLE=sendspin
SENDSPIN_ID=ha-dev-satellite-1
SENDSPIN_NAME='HA Satellite'

# Vacío: Sendspin escucha y se anuncia por mDNS. En macOS con Music Assistant
# dentro de Docker conviene conectar explícitamente al puerto publicado.
MUSIC_ASSISTANT_SENDSPIN_URL=ws://macserver2.local:8927/sendspin

# Vacío usa la salida predeterminada. Consulta opciones con:
# sendspin audio-devices list
SENDSPIN_AUDIO_DEVICE=
# Opcional cuando el equipo tiene varias interfaces de red.
SENDSPIN_INTERFACE=
