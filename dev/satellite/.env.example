SATELLITE_ID=dev-satellite-1
DISPLAY_PORT=8080
AUDIO_API_PORT=3200
# En producción se usa /etc/ha/satellite.env y, por defecto, /etc/ha/satellite/*.json.
# Estas rutas explícitas mantienen el entorno de desarrollo dentro del repositorio.
AUDIO_CONFIG_PATH=dev/satellite/config/audio.json
ASSISTANT_CONFIG_PATH=dev/satellite/config/assistant.json
SERVER_CONFIG_PATH=dev/satellite/config/server.json
SERVER_RECONNECT_DELAY_MS=10000
WAKE_WORD_PROVIDER=vosk
WAKE_WORD_COMMAND_TIMEOUT_MS=7000
WAKE_WORD_COOLDOWN_MS=2000
WAKE_WORD_EXACT_MIN_CONFIDENCE=0.72
WAKE_WORD_EMBEDDED_MIN_CONFIDENCE=0.90
VOICE_SILENCE_DURATION_MS=800
VOICE_DUCK_VOLUME_PERCENT=10
VOICE_MAX_PHRASE_SECONDS=8
VOICE_INITIAL_NOISE_FLOOR_DB=-50
VOICE_SPEECH_START_MARGIN_DB=10
VOICE_SPEECH_END_MARGIN_DB=6
VOICE_COMMAND_SPEECH_START_MARGIN_DB=6
VOICE_COMMAND_MINIMUM_SPEECH_MS=100
VOICE_COMMAND_PRE_ROLL_MS=400
VOSK_PYTHON=dev/satellite/.venv/bin/python
VOSK_SCRIPT_PATH=apps/satellite/src/voice/vosk_detector.py
VOSK_MODEL_PATH=dev/satellite/models/vosk-model-small-es-0.42
# Cliente oficial que expone este satélite como reproductor de Music Assistant.
SENDSPIN_EXECUTABLE=sendspin
# Vacío usa descubrimiento mDNS. Alternativa: ws://IP_SERVIDOR_MA:8927/sendspin
MUSIC_ASSISTANT_SENDSPIN_URL=
