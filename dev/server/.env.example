SERVER_PORT=3000
FOLLOW_UP_TIMEOUT_MS=8000
VOICE_INPUT_METRICS_INTERVAL_MS=10000
VOICE_INPUT_RING_BUFFER_MS=3000
VOICE_INPUT_DISCONTINUITY_MS=250
VOICE_STATE_LISTENING_TIMEOUT_MS=7000
VOICE_INITIAL_NOISE_FLOOR_DB=-50
VOICE_SPEECH_START_MARGIN_DB=8
VOICE_SPEECH_END_MARGIN_DB=5
VOICE_MINIMUM_SPEECH_MS=120
VOICE_SILENCE_DURATION_MS=800
VOICE_PRE_ROLL_MS=400
VOICE_MAXIMUM_PHRASE_MS=8000
VOICE_CONTINUOUS_PARTIAL_INTERVAL_MS=700
VOICE_CONTINUOUS_PARTIAL_MINIMUM_MS=700
HOME_ASSISTANT_URL=http://127.0.0.1:8123
# En producción se usa /etc/ha/server.env y, por defecto, /etc/ha/server/*.json.
# Estas rutas explícitas mantienen el entorno de desarrollo dentro del repositorio.
SERVER_CONFIG_PATH=dev/server/config/server.json
# Vacíos usan "Servidor <hostname>" e identity-<hostname>.json.
SERVER_NAME=
SERVER_IDENTITY_PATH=
ALARM_CONFIG_PATH=dev/server/config/alarms.json
# TTS central con Kokoro.
TTS_CONFIG_PATH=dev/server/config/tts.json
KOKORO_PYTHON=dev/server/.venv-kokoro/bin/python
KOKORO_DEVICE=auto
MUSIC_GATEWAY_URL=http://127.0.0.1:3100
MUSIC_GATEWAY_PORT=3100
# Tiempo total permitido para una operación completa del gateway.
MUSIC_GATEWAY_TIMEOUT_MS=90000
MUSIC_CONFIG_PATH=dev/server/config/music.json
# Servidor Music Assistant. El token sólo es necesario si MA tiene autenticación habilitada.
MUSIC_ASSISTANT_URL=http://127.0.0.1:8095
MUSIC_ASSISTANT_TOKEN=
# Tiempo máximo para cada llamada individual a Music Assistant.
MUSIC_ASSISTANT_TIMEOUT_MS=30000
MUSIC_ASSISTANT_LOG_LEVEL=info
MUSIC_ASSISTANT_ENV_PATH=dev/server/.music-assistant.env
MUSIC_ASSISTANT_STARTUP_TIMEOUT_SECONDS=30
# Opcional. En macOS se detecta automáticamente la IP LAN usada por los reproductores.
MUSIC_ASSISTANT_PUBLISH_IP=
WHISPER_LANGUAGE=es
WHISPER_SERVER_CLI=whisper-server
WHISPER_SERVER_HOST=127.0.0.1
WHISPER_SERVER_PORT=8178
WHISPER_SERVER_MANAGED=true
WHISPER_SERVER_STARTUP_TIMEOUT_MS=120000
WHISPER_SERVER_REQUEST_TIMEOUT_MS=120000
WHISPER_MODEL=large-v3
WHISPER_MODEL_DIR=dev/server/models
# Opcional: ruta o URL personalizadas. Si se omiten se derivan de WHISPER_MODEL.
WHISPER_MODEL_PATH=
WHISPER_MODEL_URL=
WHISPER_NO_GPU=false
WHISPER_THREADS=4
WHISPER_BEST_OF=2
ASSISTANT_PURPOSE="Asistente doméstico por voz"
# La selección del proveedor se guarda desde el display en server.json.
# Estos valores son los predeterminados para Ollama.
SERVER_SECRETS_PATH=dev/server/config/secrets.json
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# Intervalo de actualización del catálogo de dispositivos, áreas y plantas de Home Assistant.
HOME_ASSISTANT_REFRESH_MS=60000
MUSIC_CATALOG_REFRESH_MS=60000
